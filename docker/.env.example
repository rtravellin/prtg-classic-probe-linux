# =============================================================================
#  PRTG Classic Probe on Linux — deployment configuration
# =============================================================================
#  Copy this file to .env and fill in YOUR values:   cp .env.example .env
#  `docker compose` reads .env automatically. NEVER commit your real .env.
# =============================================================================

# ---- PRTG core connection ---------------------------------------------------
# The FQDN of your PRTG core server (must match the core's TLS certificate CN).
CORE_SERVER=your-prtg-server.example.com
# The core's IP. Required unless this Docker host's DNS already resolves CORE_SERVER.
# (Used to pin CORE_SERVER → IP via the probe container's extra_hosts.)
CORE_IP=192.0.2.10
# The core's probe-connection port (Setup ▸ Core & Probes ▸ Probe Connection Settings).
CORE_PORT=23560

# ---- Probe identity / auth --------------------------------------------------
# 8-hex access key from the remote-probe installer you downloaded from your core
# (Setup ▸ Probes ▸ "Add Remote Probe"), or from the installer filename.
PROBE_KEY=your-access-key
# Display name the probe shows in the PRTG device tree.
PROBE_NAME=Linux-Probe
# Reuse an already-approved probe GId to reconnect straight to "Up". Leave EMPTY for
# a brand-new probe — approve it once in the PRTG UI, then (optionally) pin its GId here.
PROBE_GID=

# ---- Sidecar shared secret --------------------------------------------------
# Gates the WMI (:8910) and PSRP (:8911) sidecars: when set, only callers that send
# this token (the probe's own facade/shims do) may query. Generate a strong value:
#   openssl rand -hex 32
# Leave EMPTY to disable the gate (the sidecars are loopback-bound regardless).
BRIDGE_TOKEN=

# ---- WMI credentials (optional) ---------------------------------------------
# A single default Windows credential the WMI bridge uses when a target isn't listed
# in /opt/wmi-bridge/targets.json and PRTG didn't pass per-device creds. Leave blank
# to rely solely on targets.json / per-request creds.
WMI_USER=
WMI_PASS=
WMI_DOMAIN=
# Directory on the host holding targets.json (mode 600). Default /opt/wmi-bridge.
WMI_TARGETS_DIR=/opt/wmi-bridge

# ---- PSRP / PowerShell remoting TLS -----------------------------------------
# Validate the target's TLS cert on the HTTPS (5986) PSRP path. Set PSRP_INSECURE_TLS=1
# ONLY for self-signed endpoints you trust.
PSRP_CERT_VALIDATION=1
PSRP_INSECURE_TLS=0

# ---- Admin panel ------------------------------------------------------------
ADMIN_USER=admin
# Leave EMPTY to have a strong random password generated and printed to the panel's
# log on first boot (docker compose logs prtg-admin | grep -A4 password). Set a value
# to pin it across restarts.
ADMIN_PASS=
# READ_ONLY=1 disables every write/control action in the panel.
READ_ONLY=0

# ---- Auto-update watchdog ---------------------------------------------------
# Path on the host to the build context (this docker/ tree: build-probe.py,
# Dockerfile.prod, patch artifacts). Required for the updater to rebuild images.
BUILD_CONTEXT_DIR=./
# Path on the host to the dir holding THIS docker-compose.yml and .env.
DEPLOY_DIR=./
# MUST match the project name the stack runs under (default "prtg"); the updater
# recreates the existing probe rather than a clone. Run `docker compose ls` to check.
COMPOSE_PROJECT_NAME=prtg
# "1" = recreate the probe automatically after a successful build (else wait for the
# operator to click Apply in the admin panel's Updates tab).
AUTO_APPLY=0
# Bind address for the updater control API (loopback by default — do not expose).
UPDATER_BIND=127.0.0.1
# Authenticode gate: only accept installers with a valid Paessler signature.
# REQUIRE_AUTHENTICODE=1 also rejects when the verifier (osslsigncode) is unavailable.
VERIFY_AUTHENTICODE=1
REQUIRE_AUTHENTICODE=0

# ---- Image tags (advanced) --------------------------------------------------
# Override only if you tag your locally-built images differently.
PROBE_TAG=1.0
SIDECAR_TAG=1.0
ADMIN_TAG=1.0
UPDATER_TAG=1.0
